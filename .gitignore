# Secrets: the app refuses to write .env unless this line is here.
.env
.env.*
!.env.example

# Node (Biome and Playwright; see package.json)
node_modules/
# Playwright traces and screenshots of failed browser tests
/test-results/

# Python
__pycache__/
*.pyc
.venv/

# Local screenshots / scratch
.shots/
.DS_Store

# Optional live evaluation reports (may contain input data and model answers)
/report.json
/reports/

# Claude Code machine-local files
.claude/settings.local.json
.claude/worktrees/

# Saved Workbench datasets hold the owner's input rows and labels: local data, not fixtures
/data/workbench/datasets/

# Secrets and local-only files
*.pem
*.key

{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    // static/js/lab/pages/ is generated by scripts/lab_inventory.mjs.
    "includes": [
      "static/js/**/*.js",
      "!static/js/lab/pages",
      "tests/js/**/*.mjs",
      "tests/browser/**/*.mjs",
      "scripts/**/*.mjs",
      "playwright.config.mjs"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    // Biome turns on its Playwright rules when package.json has @playwright/test; they belong to the browser tests
    // only (elsewhere they mistake functions named describe or test for Playwright's).
    "domains": { "playwright": "none" },
    "rules": {
      "preset": "recommended",
      "suspicious": {
        // Off when Biome was added: each had many existing findings in deliberate code. Enable one at a time later.
        "noAssignInExpressions": "off", // 63 findings, mostly `while ((m = re.exec(s)))` loops
        "noControlCharactersInRegex": "off", // 27 findings in regexes that strip or detect control characters
        "useIterableCallbackReturn": "off" // 91 findings, mostly forEach callbacks written as expressions
      },
      "correctness": {
        "noPrecisionLoss": "off" // the full-precision constants in static/js/lab/lib/math.js
      }
    }
  },
  "overrides": [{ "includes": ["tests/browser/**"], "linter": { "domains": { "playwright": "recommended" } } }],
  "assist": {
    "enabled": false
  }
}
